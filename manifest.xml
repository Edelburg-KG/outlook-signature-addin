<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="MailApp">
  <Id>4239b400-4f34-4323-b6a0-d407f5d34572</Id>
  <Version>1.5</Version>
  <ProviderName>Edelburg GmbH &amp; Co. KG</ProviderName>
  <DefaultLocale>en-us</DefaultLocale>
  <DisplayName DefaultValue="Edelburg Signature"/>
  <Description DefaultValue="Automatically inserts your Edelburg email signature when you compose, reply, or forward."/>
  <IconUrl DefaultValue="https://edelburg-kg.github.io/outlook-signature-addin/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://edelburg-kg.github.io/outlook-signature-addin/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/Edelburg-KG/outlook-signature-addin"/>
  <AppDomains>
    <AppDomain>https://s3-signatures.edelburg.net</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="Mailbox" />
    </Sets>
  </Requirements>

  <!-- Legacy schema, superseded by VersionOverrides below on any client that
       understands it. Kept only so very old hosts don't reject the manifest
       outright; it has no UI of its own. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://edelburg-kg.github.io/outlook-signature-addin/functions.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
  <DisableEntityHighlighting>true</DisableEntityHighlighting>
  <!-- /Legacy schema. -->

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Description resid="residAppDesc" />

      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <!-- Event-based activation: runs checkSignature() whenever the
               user opens a new compose window (new message, reply, or
               forward), with no task pane or click required. -->
          <Runtimes>
            <Runtime resid="Functions.Url">
              <Override type="javascript" resid="Functions.Js.Url"/>
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <!-- Required by the schema whenever commands are declared; no
                 command uses it (the button below opens a task pane). -->
            <FunctionFile resid="Functions.Url" />

            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="checkSignature" />
              </LaunchEvents>
              <SourceLocation resid="Functions.Url" />
            </ExtensionPoint>

            <!-- "Signatur" button on the compose ribbon: opens taskpane.html,
                 which lists the mailbox's signatures from <domain>/<local>.json on R2.
                 That list lives outside the manifest on purpose, so adding
                 a signature never needs a manifest update. -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="SignatureGroup">
                  <Label resid="SignatureGroup.Label" />
                  <Control xsi:type="Button" id="SignatureButton">
                    <Label resid="SignatureButton.Label" />
                    <Supertip>
                      <Title resid="SignatureButton.Label" />
                      <Description resid="SignatureButton.Tip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://edelburg-kg.github.io/outlook-signature-addin/assets/icon-16.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://edelburg-kg.github.io/outlook-signature-addin/assets/icon-32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://edelburg-kg.github.io/outlook-signature-addin/assets/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Functions.Url" DefaultValue="https://edelburg-kg.github.io/outlook-signature-addin/functions.html"></bt:Url>
          <bt:Url id="Functions.Js.Url" DefaultValue="https://edelburg-kg.github.io/outlook-signature-addin/functions.js"></bt:Url>
          <bt:Url id="Taskpane.Url" DefaultValue="https://edelburg-kg.github.io/outlook-signature-addin/taskpane.html"></bt:Url>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="SignatureGroup.Label" DefaultValue="Edelburg" />
          <bt:String id="SignatureButton.Label" DefaultValue="Signatur" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="residAppDesc" DefaultValue="Automatically inserts your Edelburg email signature when you compose, reply, or forward."></bt:String>
          <bt:String id="SignatureButton.Tip" DefaultValue="Andere Signatur für diese E-Mail auswählen." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
